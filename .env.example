# ローカル開発用の環境変数の雛形。
#
# 使い方: このファイルを .env にコピーして値を埋める。
# **.env はコミットしない**（.gitignore で除外済み）。
# scripts/dev.sh が .env を読む（scripts/test-integration.sh は読まない。
# 統合テストはエミュレータ前提の固定値で動くため）。

# API の利用を許可するメールアドレス（カンマ区切り）。
# **ここに書いたアドレスだけが 200 を得られる。**
# 一致しないアドレスの ID トークンは 403 になる。
# 自分の Google アカウントで試すときは、そのアドレスに書き換えること。
ALLOWED_EMAILS=dev@example.com

# Firebase のプロジェクト ID。
# **demo- で始まる ID を使うとエミュレータが完全にオフラインで動く。**
# 本物の GCP プロジェクトへ誤って接続する事故を防げるため、ローカルではこのままにする。
FIREBASE_PROJECT_ID=demo-octant

# 動作環境。local / dev / prod のいずれか。**必須。既定値は無い。**
# 未設定・空文字・それ以外の値では起動しない。
#
# 既定値を持たせていないのは、Cloud Run で入れ忘れたときに local 扱いで
# 起動すると、下記のエミュレータ混入ガードが無効になるため。
# local 以外にすると FIREBASE_AUTH_EMULATOR_HOST が拒否される
# （エミュレータ接続時は ID トークンの署名検証が省略されるため）。
#
# make dev は未設定なら local を補うので、ローカルではこのままでよい。
APP_ENV=local

# ログの下限。debug / info / warn / error。
LOG_LEVEL=debug

# 待ち受けポート。既定のまま使う場合は指定しなくてよい。
# API_PORT=8080
# AUTH_EMULATOR_PORT=9099
# FIRESTORE_EMULATOR_PORT=8808
