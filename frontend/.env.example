# フロントエンドの環境変数の雛形。
#
# 使い方: このファイルを frontend/.env にコピーして値を埋める。
# **.env はコミットしない**（.gitignore で除外済み）。
#
# Vite は VITE_ で始まる変数だけをクライアントに渡す。
# **ここに書いた値はブラウザに配布される。秘密情報を置かないこと。**

# ---------------------------------------------------------------------------
# Firebase の設定
# ---------------------------------------------------------------------------
#
# **これらは秘密情報ではない。** Firebase の設計上クライアントに配布される値で、
# 公開されても問題ない（アクセス制御は Firebase Auth のセキュリティルールと
# サーバ側の許可メール照合が担う）。
#
# ただし**プロジェクト固有**なので、リポジトリに実値は置かない。
# 取得方法は docs/gcp-bootstrap.md の「ウェブアプリを登録して firebaseConfig を取得」を参照。
#
# 対応する GCP プロジェクト:
#   prod  octant-prod
#   dev   octant-dev

VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=octant-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=octant-dev
VITE_FIREBASE_STORAGE_BUCKET=octant-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ---------------------------------------------------------------------------
# ローカル開発
# ---------------------------------------------------------------------------
#
# Auth エミュレータに接続するかどうか。
# make dev で開発するときは true にする。**本番ビルドでは絶対に true にしない。**
#
# true のときフロントは上記の Firebase 設定を使わず、
# localhost:9099 のエミュレータに接続する。
VITE_USE_AUTH_EMULATOR=true

# エミュレータの待ち受け先。既定のまま使う場合は指定しなくてよい。
# VITE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
