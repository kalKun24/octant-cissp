rules_version = '2';

// **全ドキュメントを拒否する。ここに認可ロジックを書き足さない。**
//
// ブラウザは Firestore に直接アクセスしない。データの読み書きはすべて
// Go の REST API を通り、サーバのサービスアカウント（Admin 権限で
// このルールを迂回する）だけが実際の読み書きを行う。
//
// この設計にしている理由は、バリデーションと認可を Go の1箇所へ集約でき、
// セキュリティルールという第2の認可ロジックを保守しなくて済むため
// （CLAUDE.md「全体構成」「守るべき制約」）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
